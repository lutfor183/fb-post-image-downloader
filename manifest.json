{
  "manifest_version": 2,
  "name": "Facebook Post Image Downloader",
  "version": "1.1.0",
  "description": "Select, preview, and download the images of the Facebook post you are viewing as one PDF.",
  "permissions": [
    "downloads",
    "tabs",
    "scripting",
    "https://facebook.com/*",
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.fbsbx.com/*"
  ],
  "background": {
    "scripts": [
      "pdf.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Download this Facebook post's photos (HD PDF)",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://facebook.com/*",
        "https://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "facebook-post-images@example.local",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}